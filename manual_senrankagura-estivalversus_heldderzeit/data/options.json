{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "goal":{
            "_comment": [
                "Using 'goal' as the name of an option let you override some of the generated goal parameters"
            ],
            "display_name": "The End Objective",
            "description": "How to End your Randomized playthrough.",
            "aliases": {"easiest": 0},
            "hidden": false
        },
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 20
            }
        }
    },
    "user": {
        "_commented_out_option":{
            "type": "Toggle",
            "default": true
        },
        "_Example_Toggle":{
            "description": [
                "This is a Toggle",
                "A simple boolean, aka True or False set the initial value with \"default\""
            ],
            "type": "Toggle",
            "default": false,
            "group": "Example Options"
        },
        "_Example_Choice":{
            "type": "Choice",
            "description": [
                "This is a Choice",
                "Let the user pick from a list of values",
                "allow_custom_value let a player define their own text value",
                "Currently the only use for Choice in Manual outside of hooks is the goal"
            ],
            "values": {
                "start":0,
                "test":1
             },
            "default": 0,
            "allow_custom_value": false,
            "group": "Example Options"
        },
        "_Example_Range":{
            "type": "Range",
            "description": [
                "This is a Range",
                "Allow the player to specify a value between 'start' and 'end'",
                "if you include a \"values\" you can define the label for certain values",
                "Currently the only use for Range in Manual outside of hooks is 'filler_trap'"
            ],
            "range_start": 0,
            "default": 1,
            "range_end": 5,
            "values": {"example": 2},
            "group": "Example Options"
        },


        
        "platforms_goal":{
            "display_name": "Require Platforms for Goal",
            "description": [
                "Option to let Festival Platforms to be required to Goal, if not already included.",
                "Amount determined by the option: \"Required Platforms for Goal Amount\""
        ],
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "Goal Options"
        },
        "platforms_goal_count":{
            "display_name": "Required Platforms for Goal Amount",
            "description": [
                "Special Missions are tough challenges.",
                "Does nothing if \"Require Platforms for Goal\" is disbaled."
        ],
            "type": "Range",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "range_start": 5,
            "default": 60,
            "range_end": 80,
            "values": {
                "minimum": 5,
                "half": 40,
                "maximum": 80
            },
            "group": "Goal Options"
        },

        "special_missions":{
            "display_name": "Include Special Missions",
            "description": [
                "Special Missions are tough challenges.",
                "Required for the Mission Pack DLC."
        ],
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "Randomization Options"
        },
        "shinobi_panties":{
            "display_name": "Shinobi Panties",
            "description": [
                "Adds in Panties for every (base) Shinobi.",
                "If Enabled: The Panties will be an alternative requirement to access the Shinobi Girl's Heart Missions."
        ],
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": true,
            "group": "Randomization Options"
        },

        "trap_seal":{
            "display_name": "Seal Traps",
            "description": [
                "Seal Traps prevent the user from using any Secret Ninja-Arts or Shinobi Transformations.",
                "The Trap is active for the duration of the current mission, or next, if not in any."
            ],
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "Trap Options"
        },

        "dlc_ikki_tousen":{
            "display_name": "Ikki Tōsen DLC",
            "description": "Adds in 3 Playable Characters from Ikki Tōsen into the Item Pool.",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "DLC Options"
        },
        "dlc_ayame":{
            "display_name": "Ayame DLC",
            "description": "Adds in Ayame as a Playable Character into the Item Pool.",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "DLC Options"
        },
        "dlc_kagura":{
            "display_name": "Kagura DLC",
            "description": "Adds in True Kagura as a Playable Character into the Item Pool.",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "DLC Options"
        },
        "dlc_naraku":{
            "display_name": "Naraku DLC",
            "description": "Adds in Naraku as a Playable Character into the Item Pool.",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "DLC Options"
        },
        "dlc_mission_pack":{
            "display_name": "Mission Pack DLC",
            "description": [
                "Adds in more Special Missions from the \"Mission Pack\" DLC.",
                "DOES NOTHING, IF \"Include Special Missions\" IS DISABLED"
            ],
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "DLC Options"
        },
        "dlc_dual_bloom":{
            "display_name": "Dual Blooming Hearts DLC",
            "description": "Adds in more, team based Missions as Locations.",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template",
                "spoiler"
            ],
            "default": false,
            "group": "DLC Options"
        }
    }

}
